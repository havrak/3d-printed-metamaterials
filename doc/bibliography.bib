@article{Kumar2024,
	author = {Kumar, Vimal and Srivastava, Gunjan and Mohan, Akhilesh},
	title = {3D-printed high-gain beam-switching dielectric transmitarray fed by an integrated lens antenna},
	journal = {Microwave and Optical Technology Letters},
	volume = {66},
	number = {6},
	pages = {e34204},
	keywords = {3D printing, aperture coupling, beam-switching, high-gain antenna, ILA, transmitarray},
	doi = {https://doi.org/10.1002/mop.34204},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/mop.34204},
	eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/mop.34204},
	abstract = {Abstract This article presents a high-gain linearly polarized three-dimensionally-printed dielectric transmitarray with an integrated lens antenna (ILA) as a feed source. The proposed transmitarray contains 1336 unit cells of 16 different types with a gradual phase change of 22.5°. The unit cells have a cross-section of 5.4 × 5.4 mm, and their height varies from 0 to 24.2 mm for different gradual phase changes. The designed transmitarray shows a maximum gain of 19.5 dBi at 28 GHz with a 3-dB beamwidth of less than 7° in both the E- and H-planes. Furthermore, a holder with seven distinct feed positions has been designed to alter the location of the feed antenna in the focal plane of the transmitarray. The main beam can be switched by exciting these feeds individually. In addition, it has an impedance bandwidth (|S11 | <−10 dB) from 24.5 GHz to 32.5 GHz for all the feed positions. The proposed antenna system is a good candidate for radar, wireless power transmission, and high-power military applications.},
	year = {2024}
}

